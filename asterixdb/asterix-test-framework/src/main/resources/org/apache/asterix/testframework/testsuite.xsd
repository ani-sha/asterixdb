<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://www.ics.uci.edu/~asterix/test"
           targetNamespace="http://www.ics.uci.edu/~asterix/test"
           elementFormDefault="qualified">

    <xs:simpleType name="CategoryEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="REWRITE" />
            <xs:enumeration value="EXECUTE" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="CompilationUnit">
        <xs:sequence>
            <xs:element name="parameter" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="TestCase">
        <xs:sequence>
            <xs:element name="compilation-unit" type="CompilationUnit" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="FilePath" type="xs:string" use="required"/>
        <xs:attribute name="ResultOffset" type="xs:int" use="optional"/>
        <xs:attribute name="Skip" type="xs:boolean" use="optional"/>
    </xs:complexType>

    <xs:complexType name="TestGroup">
        <xs:sequence>
            <xs:element name="test-case" type="TestCase" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="category" type="CategoryEnum" use="required"/>
    </xs:complexType>

    <xs:element name="test-suite">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="test-group" type="TestGroup" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>

